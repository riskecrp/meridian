# Meridian bot — environment reference.
#
# The bot reads ONE .env file: BOT_ENV_PATH when set, otherwise the repo-root
# .env (../.env from this folder; the same file the dashboard and the systemd
# EnvironmentFile use). Copy the root .env.example to .env and add the keys
# below that the dashboard does not already have. Nothing is hardcoded in
# code: with a key missing the matching feature says so in the log and in
# sync_status instead of pointing at someone else's server.

# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=              # bot token from the Discord developer portal
GUILD_ID=                       # the FM guild: slash commands are registered here; staff sync, leadership-mention capture and channel links use it
DATABASE_PATH=/opt/meridian/data/meridian.db   # the SQLite file shared with the dashboard

# ── Recommended ───────────────────────────────────────────────────────────────
BASE_URL=https://ecrpfm.com     # dashboard origin used in every link the bot posts (shared/pings.js urls.*)
DISCORD_CLIENT_ID=              # application id; only needed for the "invite the bot" link in the RCF setup checklist (command registration uses the logged-in client)
BOT_ENV_PATH=                   # optional: an explicit .env path instead of ../.env

# ── Identities (policy 12: never in code) ─────────────────────────────────────
RISK_DISCORD_ID=                # the owner's Discord id (shared/owners.js); owners are L3 everywhere
OWNER_IDS=                      # comma-separated extra owner ids (optional)
GA_DISCORD_INVITE=              # invite link to the Game Affairs Discord, shown on the RCF setup checklist
GARAGE_FORM_URL=                # link to the Initial Garage Request form, shown on the RCF setup checklist

# ── Google Sheets intakes ─────────────────────────────────────────────────────
# Sheet ids are the long token in the sheet URL; the gid is the tab (blank = first tab).
# With GOOGLE_SHEETS_API_KEY set the Sheets API is used (and the CSV export is the
# fallback); without it the sheet must be shared "Anyone with the link can view".
GOOGLE_SHEETS_API_KEY=
SHEET_FEEDBACK_ID=1T6d-I_P1Gvr1nyJctk0-LM3xlXEBUNCi3CMM2MWrUoQ     # ECRP roleplay feedback form responses
SHEET_FEEDBACK_GID=1222111670
FEEDBACK_TEAM_VALUE=Criminal Faction Management (FM)              # the team column value that makes a feedback row ours
SHEET_RCF_APPLICATION_ID=1_CWtU4LA-sH6IeD-rnCVq_PFcOo_e9rMZ1Pac6kDVMQ
SHEET_RCF_APPLICATION_GID=
SHEET_STAFF_APPLICATION_ID=1n485B947BGHbyf1U3xZd4V2wGAMPeK4DQZFBG6n2LCQ
SHEET_STAFF_APPLICATION_GID=1145131757
SHEET_GARAGE_REQUEST_ID=1JIZGWKHYik3cMul1L1J3a4ZLXNYWSTFiXz92wPFSHYo
SHEET_GARAGE_REQUEST_GID=
SHEET_CI_APPLICATION_ID=1ZgUuEPhXZow3m3i32w0mbk0mKZoWxJP5bAAPEqioW14
SHEET_CI_APPLICATION_GID=

# ── Optional features ─────────────────────────────────────────────────────────
OPENAI_API_KEY=                 # /summarize; without it the command says it is not configured
OPENAI_MODEL=gpt-4o-mini        # model for /summarize
PROMO_GUN_CATEGORIES=           # comma-separated import_items.category values polled on promotion (default: the ten weapon categories in promotionReview.js)
NODE_ENV=production

# Meridian environment — copy to .env and fill in. Loaded by both services
# via systemd EnvironmentFile and dotenv (bot).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
GUILD_ID=
DATABASE_PATH=/opt/meridian/data/meridian.db
NODE_ENV=production
BASE_URL=https://ecrpfm.com
SESSION_SECRET=
OPENAI_API_KEY=
IMGBB_API_KEY=
NOTIFY_SECRET=
AGENDA_SECRET=
# Optional override; defaults to the owner id baked into src/lib/constants.js
#RISK_DISCORD_ID=

# Meridian environment — copy to .env and fill in. Loaded by both services
# via systemd EnvironmentFile and dotenv (bot).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
GUILD_ID=
DATABASE_PATH=/opt/meridian/data/meridian.db
NODE_ENV=production
BASE_URL=https://ecrpfm.com
# Signs /verify sessions. Optional: unset, a random secret is generated once at <data dir>/.session_secret.
SESSION_SECRET=
OPENAI_API_KEY=
IMGBB_API_KEY=
NOTIFY_SECRET=
# The owner's Discord user ID. Always gets full (L3) access at login, even with
# no matching roles — set this to YOUR id on a fresh self-hosted copy so you can
# get in before any roles are mapped. Defaults to the id in src/lib/constants.js.
#RISK_DISCORD_ID=

# ── Identity / configuration (all optional; defaults are the production values) ──
# Comma-separated Discord user ids with owner powers (view-as, audit prune).
#OWNER_IDS=
# Guild the dashboard checks membership against (also used client-side for thread links).
#NEXT_PUBLIC_GUILD_ID=
# The /verify portal. SESSION_SECRET (above) is optional: unset, a random secret
# is generated once next to the database. VERIFY_ROLE_ID narrows the portal to
# one Discord role (unset = any member of the verify guild); VERIFY_GUILD_ID
# defaults to the production guild.
#VERIFY_GUILD_ID=
#VERIFY_ROLE_ID=
# Link shown in the api/notify feedback embed (defaults to the production sheet).
#NOTIFY_FEEDBACK_SHEET_URL=
# Map tiles for the GTA map (Leaflet); defaults to the Rockstar CDN.
#NEXT_PUBLIC_MAP_TILES=
# Google Sheets intake: API key for private sheets (falls back to the CSV export URL).
#GOOGLE_SHEETS_API_KEY=
# Bot: path to the .env file (defaults to the repo root .env).
#BOT_ENV_PATH=
# Backups (scripts/backup.sh): where to write, how many to keep, log retention window.
#BACKUP_DIR=
#BACKUP_KEEP=14
#RETAIN_DAYS=180

# ── Bot: Google Forms intake and extras (full notes in bot/.env.example) ──
# Sheet ids/gids of the intake forms. Optional: the code defaults to the
# production sheets (bot/.env.example lists them); set these to point elsewhere.
#SHEET_FEEDBACK_ID=
#SHEET_FEEDBACK_GID=
#FEEDBACK_TEAM_VALUE=Criminal Faction Management (FM)
#SHEET_RCF_APPLICATION_ID=
#SHEET_RCF_APPLICATION_GID=
#SHEET_STAFF_APPLICATION_ID=
#SHEET_STAFF_APPLICATION_GID=
#SHEET_GARAGE_REQUEST_ID=
#SHEET_GARAGE_REQUEST_GID=
#SHEET_CI_APPLICATION_ID=
#SHEET_CI_APPLICATION_GID=
# Links shown on the RCF setup checklist.
#GA_DISCORD_INVITE=
#GARAGE_FORM_URL=
# /summarize model; the ten weapon categories polled on promotion (comma-separated).
#OPENAI_MODEL=gpt-4o-mini
#PROMO_GUN_CATEGORIES=
